-- pgdelta 0.1.0 migration
-- from: <17_identity_options_change/from.sql>
-- to:   <17_identity_options_change/to.sql>
--
-- The first block runs inside a single transaction.
-- Any following block must run outside a transaction block.

BEGIN;

ALTER TABLE "public"."counters" ALTER COLUMN "id" SET INCREMENT BY 5;

ALTER TABLE "public"."counters" ALTER COLUMN "id" SET START WITH 100;

ALTER TABLE "public"."counters" ALTER COLUMN "id" SET CACHE 20;

ALTER TABLE "public"."counters" ALTER COLUMN "id" SET CYCLE;

COMMIT;
