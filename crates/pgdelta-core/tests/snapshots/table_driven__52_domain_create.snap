-- pgdelta 0.5.0 migration
-- from: <52_domain_create/from.sql>
-- to:   <52_domain_create/to.sql>
--
-- The first block runs inside a single transaction.
-- Any following block must run outside a transaction block.

BEGIN;

CREATE DOMAIN "public"."email" AS text CONSTRAINT "email_check" CHECK ("value" ~ '^[^@]+@[^@]+$');

COMMIT;
