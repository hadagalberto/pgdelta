BEGIN;

DROP TYPE "public"."posint";

CREATE DOMAIN "public"."posint" AS integer CONSTRAINT "posint_check" CHECK ("value" > 0) CONSTRAINT "posint_not_null" NOT NULL;

COMMIT;
