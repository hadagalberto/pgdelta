-- pgdelta 0.1.0 migration
-- from: <20_generated_expr_change/from.sql>
-- to:   <20_generated_expr_change/to.sql>
--
-- The first block runs inside a single transaction.
-- Any following block must run outside a transaction block.

BEGIN;

ALTER TABLE "public"."invoices" DROP COLUMN "total";

ALTER TABLE "public"."invoices" ADD COLUMN "total" numeric(10,2) GENERATED ALWAYS AS ("subtotal" * 3) STORED;

COMMIT;
