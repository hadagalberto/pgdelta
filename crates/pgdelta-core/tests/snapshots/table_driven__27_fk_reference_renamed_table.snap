-- pgdelta 0.1.0 migration
-- from: <27_fk_reference_renamed_table/from.sql>
-- to:   <27_fk_reference_renamed_table/to.sql>
--
-- The first block runs inside a single transaction.
-- Any following block must run outside a transaction block.

BEGIN;

ALTER TABLE "public"."orders" DROP CONSTRAINT "orders_user_id_fkey";

DROP TABLE "public"."users";

CREATE TABLE "public"."members" (
    "id" bigint NOT NULL,
    CONSTRAINT "members_pkey" PRIMARY KEY ("id")
);

ALTER TABLE "public"."orders" ADD CONSTRAINT "orders_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "public"."members" ("id");

COMMIT;
