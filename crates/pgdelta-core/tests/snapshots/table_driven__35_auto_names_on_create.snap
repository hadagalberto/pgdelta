BEGIN;

CREATE TABLE "public"."t" (
    "a" integer NOT NULL,
    "b" text,
    CONSTRAINT "t_pkey" PRIMARY KEY ("a"),
    CONSTRAINT "t_b_key" UNIQUE ("b"),
    CONSTRAINT "explicit_name" CHECK ("b" <> '')
);

