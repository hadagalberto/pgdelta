---
-- pgdelta 0.4.0 migration
-- from: <69_trigger_change/from.sql>
-- to:   <69_trigger_change/to.sql>
--
-- The first block runs inside a single transaction.
-- Any following block must run outside a transaction block.

BEGIN;

DROP TRIGGER "check_update" ON "public"."accounts";

CREATE TRIGGER "check_update" AFTER UPDATE ON "public"."accounts" FOR EACH ROW EXECUTE FUNCTION "public"."audit_update"();

COMMIT;
